#!/usr/bin/env fish
# --- logging ---
set -l LOG ~/.local/state/hypr/autostart.log
mkdir -p (dirname $LOG)
echo (date --iso-8601=seconds)"  autostart begin" >> $LOG

# --- environment (Wayland apps) ---
set -gx XDG_CURRENT_DESKTOP Hyprland
set -gx XDG_SESSION_TYPE wayland
set -gx MOZ_ENABLE_WAYLAND 1

# --- systemd / D-Bus session integration ---
# Push the Wayland session env into BOTH the systemd user manager and the
# D-Bus activation environment, THEN bring up the session target. This is what
# lets xdg-desktop-portal activate: xdg-desktop-portal.service has
# `Requisite=graphical-session.target`, and hyprland-session.target BindsTo
# that target — so starting it flips graphical-session.target active and
# unblocks the portal frontend (and thus ScreenCast for browser/OBS screen
# sharing). The env push must complete first so portal children inherit
# WAYLAND_DISPLAY / XDG_CURRENT_DESKTOP.
# Must run before the tmux early-exits below.
# See hypr/PORTAL-SESSION.md and init.sh:init_portal_session (the target unit
# is symlinked into ~/.config/systemd/user by init.sh).
# Run SYNCHRONOUSLY (no `&`): backgrounding raced the systemd user manager at
# login and the target-start silently lost, leaving xdg-desktop-portal blocked
# (Requisite=graphical-session.target). Starting a passive target is near-instant.
dbus-update-activation-environment --systemd --all >> $LOG 2>&1
systemctl --user start hyprland-session.target >> $LOG 2>&1

# --- paths ---
set -l CONFIG $HOME/dotfiles/hypr
set -l SCRIPTS_DIR $CONFIG/scripts

$SCRIPTS_DIR/journal.sh
# --- Waybar ---
if type -q waybar
    if test -x $SCRIPTS_DIR/launch_waybar
        nohup $SCRIPTS_DIR/launch_waybar >> $LOG 2>&1 &
    else
        nohup waybar >> $LOG 2>&1 &
    end
end

# --- Wallpaper (ensure your script exists / is executable) ---
set WALLPAPER_PATH "studio_gibbs.png"
if test -x $SCRIPTS_DIR/wall
    nohup $SCRIPTS_DIR/wall $CONFIG/wallpapers/$WALLPAPER_PATH >> $LOG 2>&1 &
else if type -q awww
    # optional fallback using awww
    awww init >> $LOG 2>&1
    awww img $CONFIG/wallpapers/$WALLPAPER_PATH >> $LOG 2>&1 &

# --- RGB effects ---
end
# if test -x $SCRIPTS_DIR/rgb
#     nohup $SCRIPTS_DIR/rgb >> $LOG 2>&1 &
# end

# --- Notifications ---
if type -q dunst
    nohup dunst >> $LOG 2>&1 &
end

# --- PolicyKit agent ---
if test -x /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
    nohup /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 >> $LOG 2>&1 &
end

# --- Hello toast ---
if type -q notify-send
    notify-send -a aurora "hello "(whoami)
end

# --- Tmux Sessions (last: these may early-exit if a session exists) ---
set SESSION "default"
tmux has-session -t $SESSION 2>/dev/null
if test $status -eq 0
    echo (date --iso-8601=seconds)"  autostart end (default session existed)" >> $LOG
    exit 0
end
tmux new-window -t $SESSION:2 -n TERMINAL
tmux new-window -t $SESSION:3 -n DOTS
tmux new-window -t $SESSION:4 -n BTOP


tmux send-keys -t $SESSION:DOTS 'cd ~/dotfiles' C-m

# BTOP
tmux send-keys -t $SESSION:BTOP 'btop' C-m

set SESSION "journal"
tmux has-session -t $SESSION 2>/dev/null
if test $status -eq 0
    echo (date --iso-8601=seconds)"  autostart end (journal session existed)" >> $LOG
    exit 0
end
tmux new-session -d -s $SESSION -n JOURNAL
tmux send-keys -t $SESSION:JOURNAL "nvim $JOURNAL_FILE" C-m

echo (date --iso-8601=seconds)"  autostart end" >> $LOG
