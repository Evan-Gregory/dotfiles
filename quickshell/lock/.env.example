# Weather widget config for the lock screen (optional).
# Copy this file to `.env` and fill in your values. Without it, the lock shows
# dummy/cached weather (the widget still renders — it just won't be live).
#
#   Get a free key at https://openweathermap.org/api
#   Find your city id at https://openweathermap.org/find

OPENWEATHER_KEY=Skipped
OPENWEATHER_CITY_ID=0
OPENWEATHER_UNIT=metric
